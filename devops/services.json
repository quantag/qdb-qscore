{
  "swagger": "2.0",
  "info": {
    "title": "QCloud Quantum API",
    "description": "API Gateway for CUDA-Q microservices (compile and run).",
    "version": "1.0.0"
  },
  "schemes": ["https"],
  "produces": ["application/json"],
  "consumes": ["application/json"],
  "x-google-endpoints": [
    {
      "name": "qcloud-gateway-asivl5za.ew.gateway.dev",
      "allowCors": true
    }
  ],
  "paths": {
    "/compile": {
      "post": {
        "summary": "Compile OpenQASM",
        "description": "Convert OpenQASM into CUDA-Q kernel source (Python or C++).",
        "operationId": "compileQasm",
        "x-google-backend": {
          "address": "https://cloud.quantag-it.com/api1/compile",
          "protocol": "h2"
        },
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "qasm": { "type": "string" },
                "type": { "type": "string", "enum": ["python", "cpp"] }
              },
              "required": ["qasm"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful compile",
            "schema": {
              "type": "object",
              "properties": {
                "output": { "type": "string" }
              }
            }
          }
        }
      },
      "options": {
        "summary": "CORS support",
        "operationId": "compileCors",
        "responses": {
          "200": {
            "description": "CORS preflight OK",
            "headers": {
              "Access-Control-Allow-Origin": { "type": "string" },
              "Access-Control-Allow-Methods": { "type": "string" },
              "Access-Control-Allow-Headers": { "type": "string" }
            }
          }
        }
      }
    },
    "/run": {
      "post": {
        "summary": "Run OpenQASM",
        "description": "Execute OpenQASM on CUDA-Q and return histogram.",
        "operationId": "runQasm",
        "x-google-backend": {
          "address": "https://cloud.quantag-it.com/api1/run",
          "protocol": "h2"
        },
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "qasm": { "type": "string" },
                "type": { "type": "string", "enum": ["python", "cpp"] }
              },
              "required": ["qasm"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful execution",
            "schema": {
              "type": "object",
              "properties": {
                "output": { "type": "string" }
              }
            }
          }
        }
      },
      "options": {
        "summary": "CORS support",
        "operationId": "runCors",
        "responses": {
          "200": {
            "description": "CORS preflight OK",
            "headers": {
              "Access-Control-Allow-Origin": { "type": "string" },
              "Access-Control-Allow-Methods": { "type": "string" },
              "Access-Control-Allow-Headers": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
